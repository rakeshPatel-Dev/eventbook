# Copy to .env for local development: cp .env.example .env
# Never commit .env (real secrets).

# Port the Express API listens on.
PORT=4000
# PostgreSQL connection string (Supabase Postgres). Backend only.
# Use Supabase's connection pooler, not the direct host: db.<ref>.supabase.co
# is IPv6-only and IPv4-only hosts (e.g. Render) cannot reach it.
# Example: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=no-verify
# Supabase requires TLS. Its root CA is self-signed, so Node rejects
# sslmode=require (SELF_SIGNED_CERT_IN_CHAIN): use sslmode=no-verify
# (encrypted, unverified), or add the CA via sslrootcert + verify-full.
DATABASE_URL=postgresql://user:password@localhost:5432/eventbook
# Optional override for the admin password created by the seed. Defaults to
# the documented test password (see README). Never commit a real value.
# SEED_ADMIN_PASSWORD=
# Explicit allowed frontend origin for CORS. Must match the web app origin.
FRONTEND_ORIGIN=http://localhost:3000
# Session cookie SameSite policy: lax (local dev default), strict, or none.
# Use none only when the frontend and API live on different sites in
# production (requires HTTPS + Secure cookies). Startup fails on invalid values.
# COOKIE_SAMESITE=lax
