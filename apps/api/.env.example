# Copy to .env for local development: cp .env.example .env
# Never commit .env (real secrets).

# Port the Express API listens on.
PORT=4000
# PostgreSQL connection string (Supabase Postgres). Backend only.
# Example: postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
DATABASE_URL=postgresql://user:password@localhost:5432/eventbook
# Explicit allowed frontend origin for CORS. Must match the web app origin.
FRONTEND_ORIGIN=http://localhost:3000
