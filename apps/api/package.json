{
  "name": "@eventbook/api",
  "version": "0.1.0",
  "private": true,
  "description": "EventBook Express REST API",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:init": "tsx src/db/apply-schema.ts",
    "db:seed": "tsx ../../database/seed.ts",
    "test": "tsx src/auth/auth.test.ts && tsx src/events/events.test.ts && tsx src/bookings/bookings.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.18.8",
    "@types/pg": "^8.16.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
