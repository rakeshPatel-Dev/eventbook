{
  "name": "eventbook",
  "version": "0.1.0",
  "private": true,
  "description": "EventBook — full-stack event booking application (monorepo foundation)",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=apps/api",
    "build": "npm run build --workspaces",
    "build:web": "npm run build --workspace=apps/web",
    "build:api": "npm run build --workspace=apps/api",
    "start:api": "npm run start --workspace=apps/api",
    "typecheck": "npm run typecheck --workspaces",
    "typecheck:web": "npm run typecheck --workspace=apps/web",
    "typecheck:api": "npm run typecheck --workspace=apps/api",
    "db:init": "npm run db:init --workspace=apps/api",
    "db:seed": "npm run db:seed --workspace=apps/api",
    "test": "npm run test --workspace=apps/api",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
