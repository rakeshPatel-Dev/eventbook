# EventBook environment placeholders (no real secrets).
# Copy per app as needed:
#   cp .env.example apps/api/.env
#   cp apps/web/.env.example apps/web/.env.local

# --- Backend (apps/api) ---
# Port the Express API listens on.
PORT=4000
# PostgreSQL connection string (Supabase Postgres). Backend only.
# Example: postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
# Supabase requires SSL: append ?sslmode=require if your client does not
# enable it by default.
DATABASE_URL=postgresql://user:password@localhost:5432/eventbook
# Safety switch for the seed script. Never set to true in production unless
# you explicitly intend to insert development accounts there.
# ALLOW_PRODUCTION_SEED=false
# Explicit opt-in for local demo seed data (demo users, events, bookings).
# The development seed refuses to run without this set to true.
# ALLOW_DEMO_SEED=true
# Strong admin password used ONLY when seeding a production database
# (requires ALLOW_PRODUCTION_SEED=true). Min 12 chars with upper/lowercase
# and a digit. Never commit a real value; never log it.
# SEED_ADMIN_PASSWORD=
# Explicit allowed frontend origin for CORS. Must match the web app origin.
# Example local dev: http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000
# Session cookie SameSite policy: lax (local dev default), strict, or none.
# Use none only when the frontend and API live on different sites in
# production (requires HTTPS + Secure cookies). Startup fails on invalid values.
# COOKIE_SAMESITE=lax

# --- Frontend (apps/web) ---
# Public base URL of the Express REST API used by the browser.
# Example local dev: http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Auth ---
# AUTH_JWT_SECRET=changeme
# NEXT_PUBLIC_AUTH_ENABLED=false
